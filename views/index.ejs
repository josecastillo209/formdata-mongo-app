<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
<h1><%= title %></h1>
<p>Welcome to <%= title %>.   Let's test reading get+post data</p>

<b>New Customer Form to test POST request to save data to MongoDB collection customers /readNameAndRespond</b>
<br/>
<form action="/saveNewCustomer" method="post">

  Name: <input type="text" name="name"> </input>
  <br/>
  Email: <input type="text" name="email"> </input>
  <br/>
  <input type="submit" value="Go"/>
</form>

<!-- New section for displaying database accounts -->
    <div id="accounts-section">
      <h2>Customer Accounts in Database</h2>
      <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
        <ul>
          <% customers.forEach(function(customer) { %>
            <li>
              <strong>Name:</strong> <%= customer.name %> | 
              <strong>Email:</strong> <%= customer.email %>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p>No customer accounts loaded yet.</p>
      <% } %>
    </div>
</body>
</html>
